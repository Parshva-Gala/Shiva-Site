# Reference only. node scripts/shiva.mjs init generates .env safely.
# Never put real secrets in this tracked example.
AUTH_SECRET=<generated-locally-64-hex-characters>
SECRET_ENCRYPTION_KEY=<different-generated-64-hex-characters>
AUTH_PROVIDERS=credentials
DB_DRIVER=better-sqlite3
DB_URL=<absolute-path-to-shiva/data/db/db.sqlite>
# Optional: override wallpaper storage with a persistent absolute local directory.
# SHIVA_ASSET_DIR=<absolute-path-to-shiva/data/shiva/wallpapers>
BASE_URL=http://127.0.0.1:3000
REDIS_IS_EXTERNAL=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
LOG_LEVEL=info
NO_EXTERNAL_CONNECTION=true
ENABLE_DOCKER=false
ENABLE_KUBERNETES=false
UNSAFE_ENABLE_MOCK_INTEGRATION=false
DEMO_MODE=false
TURBO_TELEMETRY_DISABLED=1
NEXT_TELEMETRY_DISABLED=1
SHIVA_WEBSOCKET_HOST=127.0.0.1
TZ=Asia/Kolkata
